# Copy to .env (git-ignored). Never commit real values.

# Supabase > Connect > Session pooler string (port 5432). Works over IPv4 and supports transactions.
# The direct connection (db.<ref>.supabase.co) is IPv6-only on many plans.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set true only if you use the Transaction pooler (port 6543).
DB_USE_NULLPOOL=false

# Server-side only. Used for Storage uploads. Never put this in the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-or-secret-key>
STORAGE_BUCKET=road-images

CORS_ORIGINS=http://localhost:3000
MODEL_PATH=ml/weights/pothole.pt
MAX_UPLOAD_MB=10
